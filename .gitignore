# --- Environment Variables (Secrets) ---
.env
.flaskenv

# ==============================================================================
# DATA VERSION CONTROL (DVC) CONFIGURATION
# ==============================================================================

# 1. Ignore ALL actual data files/folders
data/raw/
data/interim/
data/processed/
data/external/

# 2. Ignore any direct CSV/Parquet/Zip files in the data root
data/*.csv
data/*.parquet
data/*.zip
data/*.gz

# 3. DO NOT ignore DVC metadata files (the pointers)
# This allows Git to track the "version" without tracking the "bytes"
!data/**/*.dvc
!.dvc/
!dvc.yaml
!dvc.lock

# 4. Ignore DVC's internal local cache and user-specific config
.dvc/cache
.dvc/tmp
.dvc/config.local
/model
/models
/test_metrics.json
/confusion.png
/confusion-failure_type.png
/confusion-target.png

# --- Models & Artifacts ---
# Ignore the actual heavy files
models/*.pkl
models/*.h5
models/*.onnx
# Ignore figures and metrics generated by the pipeline
*.png
*.json


!models/*.dvc

# ---> Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
